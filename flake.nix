{
  description = "V2CC Mac mini standard setup";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

    nix-darwin = {
      url = "github:nix-darwin/nix-darwin/master";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    home-manager = {
      url = "github:nix-community/home-manager/master";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    nix-homebrew.url = "github:zhaofengli/nix-homebrew";
  };

  outputs = inputs@{
    nixpkgs,
    nix-darwin,
    home-manager,
    nix-homebrew,
    ...
  }:
  let
    # machine.nix is generated by prepare.sh from the live machine and is
    # never committed. A nix-darwin system is one machine-wide generation,
    # so it must declare every account it manages, not only the account
    # that happens to run the deploy.
    machine = import ./machine.nix;
    inherit (machine) primaryUser homebrewUser customerUser users;
    inherit (nixpkgs) lib;

    homeOf = name: "/Users/${name}";

    # The V2CC standard home. Changing it changes the Home Manager
    # generation of every managed user, which deploy.sh refuses by default.
    standardHome = name: {
      home.stateVersion = "25.11";
      home.homeDirectory = homeOf name;
      programs.home-manager.enable = true;
    };
  in
  assert lib.assertMsg (users != [ ]) "machine.nix: users must not be empty";
  assert lib.assertMsg (lib.elem customerUser users) "machine.nix: customerUser must be one of users";
  {
    darwinConfigurations."v2cc-test" =
      nix-darwin.lib.darwinSystem {
        modules = [
          home-manager.darwinModules.home-manager
          nix-homebrew.darwinModules.nix-homebrew
          ./modules/always-on.nix

          ({ pkgs, ... }: {
            nixpkgs.hostPlatform = "aarch64-darwin";
            system.stateVersion = 6;

            # Exactly one user: nix-darwin applies its remaining per-user
            # options (Homebrew, user defaults, launchd user agents) to it.
            # It is not a list of managed users and must not change when
            # another account deploys.
            system.primaryUser = primaryUser;
            users.users = lib.genAttrs users (name: { home = homeOf name; });

            # The customer's standard account. auto-login.sh logs in only
            # this account, and verify.sh checks Homebrew belongs to it.
            # Readable by every account on the Mac.
            environment.etc."v2cc/customer".text = "${customerUser}\n";

            # Determinate Nix manages Nix itself.
            nix.enable = false;

            environment.systemPackages = with pkgs; [
              git
              home-manager
              nodejs
            ];

            homebrew = {
              enable = true;
              # The account that owns /opt/homebrew, whoever deploys.
              user = homebrewUser;
              onActivation.cleanup = "none";
              onActivation.autoUpdate = false;
              onActivation.upgrade = false;
              brews = [];
              casks = [];
            };

            home-manager.useGlobalPkgs = true;
            home-manager.useUserPackages = true;

            home-manager.users = lib.genAttrs users standardHome;

            # Adopt existing Homebrew installation.
            nix-homebrew = {
              enable = false;
              user = homebrewUser;
              enableRosetta = false;
              autoMigrate = false;
            };
          })
        ];
      };
  };
}
